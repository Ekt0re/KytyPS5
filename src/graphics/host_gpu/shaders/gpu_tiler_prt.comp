#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint TILE = 0u;
const uint BLOCK_BYTES = 65536u;
#include "gpu_tiler_standard64.inc"
uvec3 block_extent() {
	uint width = ELEMENT_BYTES <= 2 ? 256u : (ELEMENT_BYTES <= 8 ? 128u : 64u);
	return uvec3(width, BLOCK_BYTES / (width * ELEMENT_BYTES), 1u);
}
uint block_offset(uvec3 p) {
	// RADV miscompiles the variable shift amounts from this specialization; constant bit
	// selects are equivalent.
	uint delta;
	if (ELEMENT_BYTES == 1) {
		delta = ((p.x & 128u) << 1) ^ ((p.y & 128u) << 2) ^ ((p.x & 64u) << 4) ^
		        ((p.y & 64u) << 5);
	} else if (ELEMENT_BYTES == 2) {
		delta = ((p.x & 128u) << 1) ^ ((p.y & 64u) << 3) ^ ((p.x & 64u) << 4) ^
		        ((p.y & 32u) << 6);
	} else if (ELEMENT_BYTES == 4) {
		delta = ((p.x & 64u) << 2) ^ ((p.y & 64u) << 3) ^ ((p.x & 32u) << 5) ^
		        ((p.y & 32u) << 6);
	} else if (ELEMENT_BYTES == 8) {
		delta = ((p.x & 64u) << 2) ^ ((p.y & 32u) << 4) ^ ((p.x & 32u) << 5) ^
		        ((p.y & 16u) << 7);
	} else {
		delta = ((p.x & 32u) << 3) ^ ((p.y & 32u) << 4) ^ ((p.x & 16u) << 6) ^
		        ((p.y & 16u) << 7);
	}
	return standard64_offset(p.xy) ^ delta;
}
#include "gpu_tiler_common.inc"
